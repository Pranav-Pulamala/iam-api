NODE_ENV=development
PORT=3000
SERVICE_NAME=iam-api
LOG_LEVEL=info
DATABASE_URL=postgresql://iam_api:iam_api_dev_password@localhost:5432/iam_api?schema=public
# Development placeholder only. Generate a different value for your private .env.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=iam-api
JWT_AUDIENCE=iam-api-client